<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Sbzilla.Views.EntityTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Sbzilla.Views">

    <UserControl.Resources>
        <DataTemplate x:Key="MessageRowTemplate" x:DataType="views:MessageRow">
            <Grid Height="30" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Seq}" Style="{StaticResource CellStyle}" FontFamily="{StaticResource CodeFont}" />
                <TextBlock Grid.Column="1" Text="{x:Bind MessageId}" Style="{StaticResource CellStyle}" />
                <TextBlock Grid.Column="2" Text="{x:Bind Subject}" Style="{StaticResource CellStyle}" />
                <TextBlock Grid.Column="3" Text="{x:Bind Enqueued}" Style="{StaticResource CellStyle}" />
                <TextBlock Grid.Column="4" Text="{x:Bind Size}" Style="{StaticResource CellStyle}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="{x:Bind Deliveries}" Style="{StaticResource CellStyle}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="6" Text="{x:Bind Session}" Style="{StaticResource CellStyle}" />
                <TextBlock Grid.Column="7" Text="{x:Bind ContentType}" Style="{StaticResource CellStyle}" />
                <TextBlock Grid.Column="8" Text="{x:Bind Reason}" Style="{StaticResource CellStyle}" ToolTipService.ToolTip="{x:Bind ReasonDetail}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PropertyRowTemplate" x:DataType="views:PropertyRow">
            <Grid ColumnSpacing="12" Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind Name}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12" FontFamily="{StaticResource CodeFont}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SubscriptionRowTemplate" x:DataType="views:SubscriptionRow">
            <Grid Height="32" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name}" Style="{StaticResource CellStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Active}" Style="{StaticResource CellStyle}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{x:Bind DeadLetter}" Style="{StaticResource CellStyle}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{x:Bind Scheduled}" Style="{StaticResource CellStyle}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="{x:Bind Status}" Style="{StaticResource CellStyle}" />
                <TextBlock Grid.Column="5" Text="{x:Bind Notes}" Style="{StaticResource CellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RuleRowTemplate" x:DataType="views:RuleRow">
            <Grid MinHeight="32" ColumnSpacing="12" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name}" Style="{StaticResource CellStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Kind}" Style="{StaticResource CellStyle}" />
                <TextBlock Grid.Column="2" Text="{x:Bind Filter}" FontFamily="{StaticResource CodeFont}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                <TextBlock Grid.Column="3" Text="{x:Bind Action}" FontFamily="{StaticResource CodeFont}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FilterAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid x:Name="Toolbar" Padding="10,6,10,6" ColumnSpacing="8" BorderThickness="0,3,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Views" SelectionChanged="Views_SelectionChanged">
                <SelectorBarItem x:Name="MessagesView" Text="Messages" IsSelected="True">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE8BD;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="SubscriptionsView" Text="Subscriptions">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE8F1;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="RulesView" Text="Rules">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE71C;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="PropertiesView" Text="Properties">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE713;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button x:Name="SendButton" Style="{StaticResource AccentButtonStyle}" Click="Send_Click" ToolTipService.ToolTip="Send a message (Ctrl+N)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE724;" FontSize="13" />
                        <TextBlock Text="Send" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="Refresh_Click" ToolTipService.ToolTip="Refresh (F5)">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
            <Border x:Name="ReadOnlyBadge" Grid.Column="2" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Visibility="Collapsed"
                    ToolTipService.ToolTip="This group is read-only: you can browse and peek, but not send, purge, delete or edit">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="ReadOnlyIcon" Glyph="&#xE72E;" FontSize="12" />
                    <TextBlock x:Name="ReadOnlyText" Text="READ-ONLY" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Messages -->
        <Grid x:Name="MessagesPane" Grid.Row="1" Padding="10,0,10,8" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="100" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="0" />
            </Grid.RowDefinitions>
            <!-- Peek controls -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="SourceBox" MinWidth="190" SelectionChanged="SourceBox_SelectionChanged" VerticalAlignment="Center"
                          ToolTipService.ToolTip="Which queue to look at: the entity itself or its dead-letter queues" />
                <NumberBox x:Name="PeekCountBox" Value="100" Minimum="1" Maximum="5000" SmallChange="50" LargeChange="500" Width="110"
                           SpinButtonPlacementMode="Compact" VerticalAlignment="Center" ToolTipService.ToolTip="How many messages to peek" />
                <Button x:Name="PeekButton" Click="Peek_Click" VerticalAlignment="Center" ToolTipService.ToolTip="Peek from the start (doesn't lock or remove messages)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7B3;" FontSize="13" />
                        <TextBlock Text="Peek" />
                    </StackPanel>
                </Button>
                <Button x:Name="PeekNextButton" Click="PeekNext_Click" VerticalAlignment="Center" IsEnabled="False"
                        ToolTipService.ToolTip="Peek the next batch after the last message shown, and add it to the list">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE893;" FontSize="13" />
                        <TextBlock Text="Next" />
                    </StackPanel>
                </Button>
                <TextBox x:Name="SessionBox" Width="170" PlaceholderText="All sessions" VerticalAlignment="Center" Visibility="Collapsed"
                         ToolTipService.ToolTip="Session-enabled entity: enter a session ID to peek just that session, or leave empty to walk the sessions with messages" />
                <TextBox x:Name="FilterBox" Width="220" PlaceholderText="Filter peeked messages (Ctrl+F)" VerticalAlignment="Center"
                         TextChanged="FilterBox_TextChanged" ToolTipService.ToolTip="Matches IDs, subject, session, properties and body text" />
            </StackPanel>
            <!-- Message actions -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="ResubmitButton" Style="{StaticResource IconButtonStyle}" Click="Resubmit_Click" IsEnabled="False"
                        ToolTipService.ToolTip="Send copies of the selected messages back to the entity">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72A;" FontSize="13" /><TextBlock Text="Resubmit" /></StackPanel>
                </Button>
                <Button x:Name="ResendButton" Style="{StaticResource IconButtonStyle}" Click="Resend_Click" IsEnabled="False"
                        ToolTipService.ToolTip="Open the selected message in the send dialog to edit and send it">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70F;" FontSize="13" /><TextBlock Text="Edit &amp; resend" /></StackPanel>
                </Button>
                <Button x:Name="DeleteButton" Style="{StaticResource IconButtonStyle}" Click="Delete_Click" IsEnabled="False"
                        ToolTipService.ToolTip="Remove the selected messages (Delete)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="13" /><TextBlock Text="Delete" /></StackPanel>
                </Button>
                <Button x:Name="CopyButton" Style="{StaticResource IconButtonStyle}" Click="Copy_Click" IsEnabled="False"
                        ToolTipService.ToolTip="Copy the selected messages as JSON (Ctrl+C)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="13" /><TextBlock Text="Copy" /></StackPanel>
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource IconButtonStyle}" Click="Save_Click" IsEnabled="False"
                        ToolTipService.ToolTip="Save the selected messages (or all shown) to a JSON file">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" FontSize="13" /><TextBlock Text="Save…" /></StackPanel>
                </Button>
                <AppBarSeparator />
                <Button x:Name="PurgeButton" Style="{StaticResource IconButtonStyle}" Click="Purge_Click"
                        ToolTipService.ToolTip="Remove every message from the selected queue">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE894;" FontSize="13" /><TextBlock Text="Purge" /></StackPanel>
                </Button>
                <Button x:Name="CancelButton" Style="{StaticResource IconButtonStyle}" Click="Cancel_Click" Visibility="Collapsed"
                        ToolTipService.ToolTip="Stop the running operation">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE71A;" FontSize="13" /><TextBlock Text="Stop" /></StackPanel>
                </Button>
            </StackPanel>
            <!-- Message list: scrolls sideways as a whole so the header stays aligned -->
            <Border Grid.Row="2" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                        <Grid MinWidth="1500">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Height="30" ColumnSpacing="12" Padding="16,0,0,0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Seq #" Style="{StaticResource ColumnHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="Message ID" Style="{StaticResource ColumnHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="Subject" Style="{StaticResource ColumnHeaderStyle}" />
                                <TextBlock Grid.Column="3" Text="Enqueued" Style="{StaticResource ColumnHeaderStyle}" />
                                <TextBlock Grid.Column="4" Text="Size" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="Deliveries" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="Session" Style="{StaticResource ColumnHeaderStyle}" />
                                <TextBlock Grid.Column="7" Text="Content type" Style="{StaticResource ColumnHeaderStyle}" />
                                <TextBlock Grid.Column="8" Text="Dead-letter reason" Style="{StaticResource ColumnHeaderStyle}" />
                            </Grid>
                            <ListView x:Name="MessageList" Grid.Row="1" SelectionMode="Extended" ItemTemplate="{StaticResource MessageRowTemplate}"
                                      SelectionChanged="MessageList_SelectionChanged" RightTapped="MessageList_RightTapped" KeyDown="MessageList_KeyDown"
                                      DoubleTapped="MessageList_DoubleTapped">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="MinHeight" Value="30" />
                                        <Setter Property="Padding" Value="16,0,0,0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </ScrollViewer>
                    <TextBlock x:Name="ListHint" Margin="16,48,16,16" TextWrapping="Wrap" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <views:PaneSplitter x:Name="DetailSplitter" Grid.Row="3" IsHorizontal="True" Target="2" ToolTipService.ToolTip="Drag to resize · double-click to reset" />
            <!-- Selected message -->
            <Grid x:Name="DetailPane" Grid.Row="4" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="380" MinWidth="160" />
                </Grid.ColumnDefinitions>
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Body" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock x:Name="BodyInfo" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <views:CodeEditor x:Name="BodyText" Grid.Row="1" IsReadOnly="True" Placeholder="Select a message to see its body." />
                </Grid>
                <views:PaneSplitter Grid.Column="1" Target="2" ToolTipService.ToolTip="Drag to resize · double-click to reset" />
                <Grid Grid.Column="2" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Properties" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border Grid.Row="1" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <ListView x:Name="PropertyList" SelectionMode="None" ItemTemplate="{StaticResource PropertyRowTemplate}" Padding="0,4" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Subscriptions (topics) -->
        <Grid x:Name="SubscriptionsPane" Grid.Row="1" Padding="10,4,10,8" RowSpacing="6" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="NewSubscriptionButton" Style="{StaticResource IconButtonStyle}" Click="NewSubscription_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="New subscription…" /></StackPanel>
                </Button>
                <TextBlock Text="Double-click a subscription to open it" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <Border Grid.Row="1" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Height="30" ColumnSpacing="12" Padding="16,0,16,0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Subscription" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="Active" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="Dead-letter" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Scheduled" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Status" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="5" Text="Notes" Style="{StaticResource ColumnHeaderStyle}" />
                    </Grid>
                    <ListView x:Name="SubscriptionList" Grid.Row="1" SelectionMode="Single" ItemTemplate="{StaticResource SubscriptionRowTemplate}"
                              DoubleTapped="SubscriptionList_DoubleTapped" />
                </Grid>
            </Border>
        </Grid>

        <!-- Rules (subscriptions) -->
        <Grid x:Name="RulesPane" Grid.Row="1" Padding="10,4,10,8" RowSpacing="6" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="AddRuleButton" Style="{StaticResource IconButtonStyle}" Click="AddRule_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Add rule…" /></StackPanel>
                </Button>
                <Button x:Name="DeleteRuleButton" Style="{StaticResource IconButtonStyle}" Click="DeleteRule_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="13" /><TextBlock Text="Delete rule" /></StackPanel>
                </Button>
            </StackPanel>
            <Border Grid.Row="1" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Height="30" ColumnSpacing="12" Padding="16,0,16,0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Rule" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="Filter" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text="Action" Style="{StaticResource ColumnHeaderStyle}" />
                    </Grid>
                    <ListView x:Name="RuleList" Grid.Row="1" SelectionMode="Single" ItemTemplate="{StaticResource RuleRowTemplate}"
                              SelectionChanged="RuleList_SelectionChanged" />
                </Grid>
            </Border>
        </Grid>

        <!-- Properties -->
        <ScrollViewer x:Name="PropertiesPane" Grid.Row="1" Visibility="Collapsed" Padding="16,8,24,16">
            <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Text="Runtime" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid x:Name="RuntimeGrid" ColumnSpacing="24" RowSpacing="6" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Name="SavePropertiesButton" Style="{StaticResource AccentButtonStyle}" Click="SaveProperties_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" FontSize="13" /><TextBlock Text="Save changes" /></StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="PropertiesError" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" IsTextSelectionEnabled="True" />
                <Border x:Name="PropertiesHost" />
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar in the group colour -->
        <Grid x:Name="StatusBar" Grid.Row="2" Height="26" Padding="10,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ProgressRing x:Name="BusyRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                <FontIcon x:Name="StateIcon" Glyph="&#xE73E;" FontSize="12" />
                <TextBlock x:Name="StateText" Text="Ready" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock x:Name="GroupText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="NamespaceText" Grid.Column="2" FontSize="12" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="CountsText" Grid.Column="3" FontSize="12" VerticalAlignment="Center" />
            <TextBlock x:Name="ShownText" Grid.Column="4" FontSize="12" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
